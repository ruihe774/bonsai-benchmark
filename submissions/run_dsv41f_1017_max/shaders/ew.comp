#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer AB { float a[]; };
layout(std430, binding = 1) readonly buffer BB { float b[]; };
layout(std430, binding = 2) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC { uint n; uint op; } pc;

void main() {
    uint i = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x;
    if (i >= pc.n) return;
    float x = a[i];
    float z = b[i];
    if (pc.op == 0u) y[i] = x + z;
    else if (pc.op == 1u) y[i] = (x / (1.0 + exp(-x))) * z;
    else if (pc.op == 2u) { uint bi = (i / 256u) * 512u + 256u + (i % 256u); float zz = b[bi]; y[i] = x / (1.0 + exp(-zz)); }
    else y[i] = x * z;
}
