#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer XB { float x[]; };
layout(std430, binding = 1) readonly buffer WB { float w[]; };
layout(std430, binding = 2) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC { uint n_in; uint w_off; } pc;

shared float red[128];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint base = pc.w_off + row * pc.n_in;
    float acc = 0.0;
    for (uint i = tid; i < pc.n_in; i += 128u) acc += x[i] * w[base + i];
    red[tid] = acc;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) y[row] = red[0];
}
