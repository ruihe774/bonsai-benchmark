#version 460
#include "common.glsl"
layout(local_size_x=256) in;
void main(){uint i=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x);if(i>=p.a)return;
 if(p.b==0)F(p.y).d[i]=F(p.x).d[i]+F(p.z).d[i];
 if(p.b==1)F(p.y).d[i]=silu(F(p.x).d[i])*F(p.z).d[i];
 if(p.b==2)F(p.y).d[i]=F(p.x).d[i]*sigmoid(F(p.z).d[i]);
 if(p.b==3)F(p.y).d[i]=F(p.x).d[i];
 if(p.b==4)F(p.y).d[i]=0;
}
